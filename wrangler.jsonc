{
  // Cloudflare-Einstellungen. Nur ändern, wenn dein R2-Bucket anders heißt.
  "name": "portfolio",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "janosch-media" }
  ],
  "observability": { "enabled": true }
}
